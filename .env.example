# Copy to .env for local development (never commit real values)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=
# Stripe (digital product sales). Webhook endpoint: https://<your-domain>/api/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: redirect www and *.onrender.com traffic to this host
CANONICAL_HOST=gatherablehub.com
PORT=10000
