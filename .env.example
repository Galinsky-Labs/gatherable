# Copy to .env for local development (never commit real values)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=
# Encrypts settings saved from the admin page (e.g. the Stripe key). Any long random string; don't change it later.
SETTINGS_ENCRYPTION_KEY=
# Optional fallback: Stripe keys can instead be pasted in /admin (preferred)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: redirect www and *.onrender.com traffic to this host
CANONICAL_HOST=gatherablehub.com
PORT=10000
